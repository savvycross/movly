# Public URL of the deployed site (used for absolute Open Graph / Twitter image URLs
# and the old-URL redirect page). Not a secret. Forks should change this to their own URL.
VITE_SITE_URL=https://movlyapp.vercel.app/
# Path the site is served under. "/" on Vercel; e.g. "/movly/" for a GitHub Pages project site.
VITE_BASE_PATH=/

# ---- $MOVLY community token + socials (all optional; see CLAUDE.md "Token & community links") ----
# Leave VITE_TOKEN_ADDRESS empty and the whole token section + header link stay hidden.
VITE_TOKEN_TICKER=MOVLY
VITE_TOKEN_ADDRESS=
# Launchpad / trade page for the token (https only).
VITE_TOKEN_URL=
# Block explorer base URL; the token page is <base>/token/<address>.
# VERIFY this against Robinhood Chain's official docs before launch.
VITE_EXPLORER_URL=https://robinhoodchain.blockscout.com
VITE_X_URL=https://x.com/movlyappp
VITE_TELEGRAM_URL=https://t.me/movlyappp
